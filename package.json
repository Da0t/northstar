{
  "name": "northstar",
  "version": "0.1.0",
  "private": true,
  "description": "Northstar — a local-first Monte Carlo goal-resilience planning lab",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
